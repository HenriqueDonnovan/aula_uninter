{
  "info": {
    "name": "Baozi Store - Testes REST",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Criar cliente, produto e pedido nesta ordem; excluir pedido antes do cliente e produto."
  },
  "item": [
    {
      "name": "Criar Cliente",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/clientes",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nome\": \"SeuNome123456\",\n  \"clienteDesde\": \"2026-10-12\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Listar Clientes",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/clientes"
      }
    },
    {
      "name": "Consultar Cliente ID 1",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/clientes/1"
      }
    },
    {
      "name": "Excluir Cliente ID 1",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{baseUrl}}/api/clientes/1"
      }
    },
    {
      "name": "Criar Produto",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/produtos",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nome\": \"Baozi de carne\",\n  \"preco\": 12.5,\n  \"estoque\": true\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Listar Produtos",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/produtos"
      }
    },
    {
      "name": "Consultar Produto ID 1",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/produtos/1"
      }
    },
    {
      "name": "Excluir Produto ID 1",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{baseUrl}}/api/produtos/1"
      }
    },
    {
      "name": "Criar Pedido",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/pedidos",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"clienteId\": 1,\n  \"produtoId\": 1,\n  \"quantidade\": 3\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Listar Pedidos",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/pedidos"
      }
    },
    {
      "name": "Consultar Pedido ID 1",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/pedidos/1"
      }
    },
    {
      "name": "Excluir Pedido ID 1",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{baseUrl}}/api/pedidos/1"
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    }
  ]
}